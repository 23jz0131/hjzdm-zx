# 环境变量配置文件（示例）
# 复制此文件为 .env 并填入真实值

# TiDB Cloud 数据库配置
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=fortune500
TIDB_USERNAME=2eXmMXiGeCt9iz7.root
TIDB_PASSWORD=your_actual_password_here

# 完整连接字符串格式（供参考）
# mysql://2eXmMXiGeCt9iz7.root:<PASSWORD>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/fortune500